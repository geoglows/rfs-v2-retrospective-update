# Variables should be exported if they need to be available to subprocesses e.g. python

# Machine/instance specific paths
export SCRIPTS_ROOT="/Users/Shared/code/rfs-v2-retrospective-update/retrospective-update"
export LOG_ROOT="/Users/Shared/logs/retrospective-update"
CONDA_ACTIVATE_PATH="/Users/Shared/miniconda3/etc/profile.d/conda.sh"
CONDA_ENV_NAME="retroupdate"
export CDSAPI_RC="/Users/Shared/environments/rfs-v2-retrospective-update/cdsapirc.txt"
export AWS_CREDENTIALS_FILE="/Users/Shared/environments/rfs-v2-retrospective-update/awscredentials"
export WEBHOOK_LOG_SILENT=""
export WEBHOOK_LOG_ALERTS=""

# shut down the machine when the script finishes? EC2 should; always-on machines should not.
export SHUTDOWN_AFTER_RUN=0

# Computation parameters
export MIN_LAG_TIME_DAYS=5
export SLEEP_LENGTH=0

# Dask LocalCluster parameters for append_discharge.py: M3 Ultra Mac Studio: 32 cores, 512 GB RAM
export DASK_N_WORKERS=32
export DASK_THREADS_PER_WORKER=2
export DASK_MEMORY_LIMIT=64GB
export DASK_TEMPORARY_DIRECTORY="/Users/Shared/workdirs/rfs-v2-retrospective-update/dask-scratch"
export DASK_ROOT_CONFIG="/Users/Shared/workdirs/rfs-v2-retrospective-update/dask-config"

# S3 locations
S3_BASE_URI="s3://geoglows-v2"
export S3_HYDROSOS_COGS="s3://geoglows-v2/hydrosos/cogs"
export S3_HYDROSOS_FILES="s3://geoglows-v2/hydrosos/*.parquet"
export S3_CONFIGS_DIR="s3://geoglows-v2/routing-configs"
export S3_FINAL_STATES_DIR="s3://geoglows-v2/retrospective/final-states"
export S3_FORECAST_INITS_DIR="s3://geoglows-v2/retrospective/forecast-inits"
export S3_HOURLY_ZARR="s3://geoglows-v2/retrospective/hourly.zarr"
export S3_DAILY_ZARR="s3://geoglows-v2/retrospective/daily.zarr"
export S3_MONTHLY_TIMESERIES_ZARR="s3://geoglows-v2/retrospective/monthly-timeseries.zarr"
export S3_MONTHLY_TIMESTEPS_ZARR="s3://geoglows-v2/retrospective/monthly-timesteps.zarr"

# Working directories
WORK_DIR="/Users/Shared/workdirs/rfs-v2-retrospective-update"
# directories populated and cleaned by the script
export DISCHARGE_DIR="${WORK_DIR}/discharge"
export ERA5_DIR="${WORK_DIR}/era5"
export HYDROSOS_DIR="${WORK_DIR}/hydrosos"
export FINAL_STATES_DIR="${WORK_DIR}/final-states"
export FORECAST_INITS_DIR="${WORK_DIR}/forecast-inits"
# data obtained from s3
export CONFIGS_DIR="${WORK_DIR}/routing-configs"
export HOURLY_ZARR="${WORK_DIR}/hourly.zarr"
export DAILY_ZARR="${WORK_DIR}/daily.zarr"
export MONTHLY_TIMESERIES_ZARR="${WORK_DIR}/monthly-timeseries.zarr"
export MONTHLY_TIMESTEPS_ZARR="${WORK_DIR}/monthly-timesteps.zarr"
# source files for making hydrosos map
export HYDROSOS_ID_PAIRS="${WORK_DIR}/hydrosos/hybas_linkno_pairs.parquet"
export HYDROSOS_BASINS="${WORK_DIR}/hydrosos/hydrobasins_level_4.parquet"
export HYDROSOS_THRESHOLDS="${WORK_DIR}/hydrosos/thresholds.parquet"
